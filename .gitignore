# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# ─── Next.js ─────────────────────────────────────────────────────────────────
/.next/
/out/
/.turbo/

# ─── Production build ────────────────────────────────────────────────────────
/build
/dist

# ─── Prisma ──────────────────────────────────────────────────────────────────
# Generated client is rebuilt via `prisma generate`; don't commit it
/prisma/generated/

# ─── Testing ─────────────────────────────────────────────────────────────────
/coverage
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/

# ─── Environment files ───────────────────────────────────────────────────────
.env
.env.local
.env*.local
.env.production
.env.staging
.env.development.local
.env.vercel

# ─── Debug logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Vercel ──────────────────────────────────────────────────────────────────
.vercel

# ─── IDE & editor artifacts ──────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── OS junk ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ─── Security ────────────────────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx

# ─── Project-specific ignores ────────────────────────────────────────────────
/misc
/docs
AGENTS.md
CLAUDE.md

.vercel
