# ─────────────────────────────────────────────
# Pay2Win Calculator — local environment
# This file ships with placeholder values so setup is self-documenting.
# Replace the REPLACE_* values with real credentials before using auth/payments.
# See docs/RAZORPAY_INTEGRATION_GUIDE.md and docs/NEON_SETUP_GUIDE.md
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# Database (local PostgreSQL for dev, Neon for prod)
# ─────────────────────────────────────────────
# Local:  postgresql://postgres:password@localhost:5432/pay2win
# Neon:   postgresql://<user>:<pass>@<host>.neon.tech/pay2win?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/pay2win"

# ─────────────────────────────────────────────
# Auth.js (NextAuth v5)
# ─────────────────────────────────────────────
# A random secret has been generated for you for local dev.
# Regenerate for production with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
AUTH_GOOGLE_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"

# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="REPLACE_WITH_GITHUB_CLIENT_ID"
AUTH_GITHUB_SECRET="REPLACE_WITH_GITHUB_CLIENT_SECRET"

# ─────────────────────────────────────────────
# Razorpay
# ─────────────────────────────────────────────
# Get keys from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID="rzp_live_REPLACE_ME"
RAZORPAY_KEY_SECRET="REPLACE_WITH_RAZORPAY_LIVE_SECRET"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_REPLACE_ME"

# Test credentials for demo account
RAZORPAY_TEST_KEY_ID="rzp_test_REPLACE_ME"
RAZORPAY_TEST_KEY_SECRET="REPLACE_WITH_RAZORPAY_TEST_SECRET"
NEXT_PUBLIC_RAZORPAY_TEST_KEY_ID="rzp_test_REPLACE_ME"

# Set this in Razorpay dashboard → Webhooks (used to verify webhook payloads)
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_WEBHOOK_SECRET"

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"